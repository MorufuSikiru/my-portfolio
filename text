}

.btn-primary{
  text-decoration: none;
background:blue ;
color: #fff;
box-shadow: 0 4px 24px rgba(37,99,235,.35);
    padding: .75rem 1.8rem;
      border-radius: 8px;
      font-size: .95rem; font-weight: 500;

}
 .btn-primary:hover { 
        box-shadow: 0 6px 32px rgba(37,99,235,.5); 
    }

    .btn-outline {
      background: transparent;
      color:#e2e8f0;
      border: 1px solid rgba(255,255,255,.18);
    }
    .btn-outline:hover 
    { border-color: cyan; 
        color: cyan; 
    }
#projects{
    background-color: blue;
}
.btn {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .75rem 1.8rem;
      border-radius: 8px;
      font-size: .95rem; font-weight: 500;
      text-decoration: none;
      transition: transform .2s, box-shadow .2s;
      cursor: pointer;  font-family: inherit;
    }
     .btn:hover { 
        transform: translateY(-2px); 
    }

    .states-section{
        position: relative;
        top: -100px;
        margin-left: 30px;
       
    }

    .hero-stats {
      margin-top: 8rem;
      display: flex; gap: 3rem;
      opacity: 0; animation: fadeUp .7s 1s forwards;
    }

    .stat-num {
      font-family: 'Syne', sans-serif;
      font-size: 2rem; font-weight: 800;
      color:white;
    }
    .stat-num span { 
        color: cyan; 
    }
    .stat-label { 
        font-size: .8rem; 
        color:gray; 
        text-transform: uppercase; letter-spacing: .08em;
     }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .scroll-hint {
      position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: .4rem;
      color: gray; font-size: .75rem; letter-spacing: .08em;
      opacity: 0; animation: fadeUp .7s 1.4s forwards;
    }
    .scroll-line {
      width: 1px; height: 40px;
      background: gray;
      animation: scrollPulse 1.5s infinite;
    }
    @keyframes scrollPulse { 
      0%,100%{
        opacity:.3
      } 
      50%{opacity:1} 
    }

    .about-section{
      display: flex;
      justify-content: center;
      align-items: center;
      color: #fff;
      gap: 20px;
