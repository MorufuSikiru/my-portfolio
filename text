*{
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}
html, body{
  overflow-x: hidden;
}
body{
background-color: #0b1120;
font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

}
:root {
      --navy:   #0b1120;
      --navy2:  #111827;
      --slate:  #1e2d45;
      --blue:   #2563eb;
      --blue-lt:#3b82f6;
      --cyan:   #38bdf8;
      --grey:   #94a3b8;
      --light:  #e2e8f0;
      --white:  #f8fafc;
      --card:   #141f30;
      --border: rgba(56,189,248,.15);
    }
header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(11,17,32,.90);
     backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(56,189,248,.15);
        position: fixed; 
      top: 0; 
      width: 100%;  
       z-index: 100;
       padding: 1.25rem;
      
}
.logo{
    margin-left: 30px;
}
nav ul {
      display: flex; justify-content: space-between; 
      align-items: center;
      column-gap: 40px;
      padding: 1.2rem 4rem;
      margin-right: 2rem;
       list-style: none;
     padding: 20px;
}



  nav li a{
    text-decoration: none;
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
      transition: color .2s;
      letter-spacing: .02em;
}
  nav li a:hover{
   color: turquoise;
}



   .nav-cta {
      background: turquoise;
      color: #fff;
      padding: .45rem 1.2rem;
      border-radius: 6px;
      transition: background .2s tomato;
    }
      .nav-cta:hover {
         background: rgb(2, 138, 125)
         }
.here-section {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    overflow-x: hidden;
